# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
*.egg-info/

# Virtual environments / package managers
.venv/
venv/
uv.lock

# Simulation-generated data (regenerate with the task scripts under Hooke/)
Hooke/logs/

# Curated documentation/demo media remain tracked; new captures are local by default.
/docs/assets/

# LeRobot-format datasets converted from Hooke/logs (regenerate with scripts/convert.py)
openpi/data/
openpi-pi0-legacy/data/

# Training outputs
checkpoints/
wandb/
*.log

# Large vendored/patched dependency clones (regenerate per README instructions)
vendor/

# OS / editor cruft
.DS_Store
*.swp

# Claude Code local session state
.claude/

# Local agent instructions
AGENTS.md

# Private/unpublished material (research proposals, drafts, notes)
private/
temp/
# webui/ robot-swap scene compositions and freejoint-stripped robot copies:
# generated on demand by webui/robot_scene.py, cached to disk, regenerable.
# (Not the same as the small, deliberately-committed set of rotor-capacity
# variants from Step 2, which don't match this "_robot_" naming pattern.)
Hooke/model/scene/*_robot_*.gen.xml
Hooke/model/robot_menagerie/*/*.gen.xml
