<?xml version="1.0" encoding="utf-8"?>
<mujoco model="round_bottom_flask_stand">
  <compiler angle="radian" autolimits="true"/>
  <default>
    <default class="body"><geom contype="1" conaffinity="1"/></default>
  </default>
  <worldbody>
    <body name="base">
      <geom type="box" size="0.08 0.08 0.005" pos="0 0 0.005" rgba="0.2 0.2 0.2 1" class="body"/>
      <geom type="cylinder" size="0.007 0.17" pos="-0.07 0 0.18" rgba="0.75 0.75 0.78 1" class="body"/>
      <geom type="box" size="0.05 0.015 0.007" pos="-0.045 0 0.28" rgba="0.75 0.75 0.78 1" class="body"/>
      <body name="flask" pos="0.02 0 0.235">
        <!-- A free joint can't sit here (not a direct child of
             worldbody, since this whole instrument is itself attached
             inside the scene's table body) -- a vertical slide (lift
             it up out of the clamp) is a real DOF without that
             restriction. -->
        <joint name="flask_joint" type="slide" axis="0 0 1" range="0 0.08" damping="1.0" frictionloss="0.3"/>
        <geom name="flask_bulb" type="sphere" size="0.045" pos="0 0 0" rgba="0.7 0.85 0.9 0.4" class="body"/>
        <!-- Widened from the original 0.007 (see private/technical-log.md):
             confirmed via contact logging that the original radius let the
             gripper pads close past it (pad-vs-pad contact, missing the
             neck entirely) rather than grip it. This radius does form a
             real, sustained pad-vs-neck contact -- see the log for the
             separate (still open) issue with actually lifting past that
             contact. -->
        <geom name="flask_neck" type="cylinder" size="0.016 0.02" pos="0 0 0.06" rgba="0.7 0.85 0.9 0.4" class="body"/>
        <site name="grasp_site" pos="0 0 0.06" size="0.005" rgba="1 0 0 1" group="4"/>
      </body>
    </body>
  </worldbody>
</mujoco>
