<mujoco model="real_lab_st_andrews_room">

    <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
        <flag multiccd="enable"/>
    </option>
    <visual>
        <global azimuth="200" elevation="-14" offwidth="1280" offheight="960"/>
    </visual>

    <default>
        <default class="body"><geom contype="1" conaffinity="1"/></default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.15 0.2 0.45" rgb2="0.12 0.17 0.4" markrgb="0.2 0.25 0.5" width="300" height="300"/>
        <material name="floormat" texture="floortex" texuniform="true" texrepeat="12 12"/>
        <model name="orbitrap" file="../instrument/real_lab_st_andrews_orbitrap.xml" content_type="text/xml" />
        <model name="table" file="../misc/simple_table.xml" content_type="text/xml" />

        <model name="ur5e" file="../robot/ur5e_gripper.xml" content_type="text/xml" />
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.55 0.55 0.55" ambient="0.55 0.55 0.55" pos="0 0 2.5" dir="0 0.3 -1"/>
        <light directional="true" diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" pos="0 -2 2.5" dir="0 -0.3 -1"/>
        <geom name="floor" pos="0 0 0" size="3.6 4.2 0.05" type="plane" material="floormat"/>
        <geom name="wall_back" type="box" pos="0 3.2 1.3" size="3.4 0.05 1.3" rgba="0.75 0.82 0.88 1"/>
        <geom name="wall_left" type="box" pos="-3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.75 0.82 0.88 1"/>
        <geom name="wall_right" type="box" pos="3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.75 0.82 0.88 1"/>
        <geom name="ceiling" type="box" pos="0 0.1 2.62" size="3.4 3.15 0.03" rgba="0.93 0.93 0.94 1"/>
        <geom type="box" pos="-1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="-1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>


        <!-- gas cylinder + regulator, left wall, per the NMR suite photo -->
        <geom type="cylinder" pos="-3.1 1.0 0.55" size="0.18 0.55" rgba="0.55 0.56 0.58 1"/>
        <geom type="box" pos="-3.1 1.0 1.18" size="0.1 0.1 0.08" rgba="0.2 0.2 0.22 1"/>
        <!-- dark control-electronics rack, left-of-bench -->
        <geom type="box" pos="-2.1 2.6 0.55" size="0.35 0.3 0.55" rgba="0.72 0.7 0.65 1"/>
        <geom type="box" pos="-2.1 2.4 1.2" size="0.35 0.3 0.1" rgba="0.15 0.15 0.17 1"/>
        <!-- glazed internal corridor wall, back-right, with a vending
             machine visible beyond -->
        <geom type="box" pos="2.2 3.15 1.7" size="1.1 0.03 0.85" rgba="0.6 0.65 0.6 0.35"/>
        <geom type="box" pos="2.8 3.2 1.1" size="0.35 0.1 0.9" rgba="0.75 0.15 0.15 1"/>
        <!-- wood-veneer door, back-left -->
        <geom type="box" pos="-3.1 3.15 1.05" size="0.45 0.03 1.0" rgba="0.5 0.32 0.18 1"/>
        <!-- open shelving with cardboard boxes, right wall -->
        <geom type="box" pos="3.3 1.5 0.9" size="0.3 0.6 0.012" rgba="0.8 0.8 0.78 1"/>
        <geom type="box" pos="3.2 1.3 1.0" size="0.15 0.12 0.1" rgba="0.82 0.72 0.55 1"/>
        <geom type="box" pos="3.2 1.65 1.0" size="0.15 0.12 0.1" rgba="0.82 0.72 0.55 1"/>

        <body name="benchA" pos="0 -1.3 0" quat="1 0 0 1">
            <attach model="table" body="vention table" prefix="/benchA:"/>
            <body name="orbitrap" pos="0.0 0.0 0.824">
                <attach model="orbitrap" body="base" prefix="/orbitrap:" />
            </body>
            <body name="1/ur5e" pos="0.5 -0. 0.824" quat="0 0 0 1">
                <attach model="ur5e" body="world" prefix="/ur:"/>
            </body>
        </body>

        <camera name="table_cam_front" pos="0 -4.4 1.9" quat="0.74967818 0.66180256 0 0" fovy="62" resolution="1280 960"/>
    </worldbody>

</mujoco>
