<mujoco model="real_lab_ucd_room">

    <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
        <flag multiccd="enable"/>
    </option>
    <visual>
        <global azimuth="200" elevation="-14" offwidth="1280" offheight="960"/>
    </visual>

    <default>
        <default class="body"><geom contype="1" conaffinity="1"/></default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.85 0.88 0.78" rgb2="0.78 0.81 0.7" markrgb="0.9 0.92 0.82" width="300" height="300"/>
        <material name="floormat" texture="floortex" texuniform="true" texrepeat="12 12"/>
        <model name="ucdcyto" file="../instrument/real_lab_ucd_conway_cytometer.xml" content_type="text/xml" />
        <model name="table" file="../misc/simple_table.xml" content_type="text/xml" />

        <model name="ur5e" file="../robot/ur5e_gripper.xml" content_type="text/xml" />
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.55 0.55 0.55" ambient="0.55 0.55 0.55" pos="0 0 2.5" dir="0 0.3 -1"/>
        <light directional="true" diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" pos="0 -2 2.5" dir="0 -0.3 -1"/>
        <geom name="floor" pos="0 0 0" size="3.6 4.2 0.05" type="plane" material="floormat"/>
        <geom name="wall_back" type="box" pos="0 3.2 1.3" size="3.4 0.05 1.3" rgba="0.88 0.9 0.86 1"/>
        <geom name="wall_left" type="box" pos="-3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.88 0.9 0.86 1"/>
        <geom name="wall_right" type="box" pos="3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.88 0.9 0.86 1"/>
        <geom name="ceiling" type="box" pos="0 0.1 2.62" size="3.4 3.15 0.03" rgba="0.94 0.95 0.93 1"/>
        <geom type="box" pos="-1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="-1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>


        <!-- wall of wash-basins, right wall, per the institute's own
             interior photo -->
        <geom type="box" pos="3.3 2.3 1.0" size="0.03 0.9 1.0" rgba="0.6 0.6 0.62 1"/>
        <geom type="box" pos="3.15 1.9 0.75" size="0.15 0.18 0.1" rgba="0.95 0.95 0.95 1"/>
        <geom type="box" pos="3.15 2.3 0.75" size="0.15 0.18 0.1" rgba="0.95 0.95 0.95 1"/>
        <geom type="box" pos="3.15 2.7 0.75" size="0.15 0.18 0.1" rgba="0.95 0.95 0.95 1"/>
        <!-- grey bench cabinets, teaching-lab row style -->
        <geom type="box" pos="-2.0 2.9 0.35" size="1.3 0.3 0.35" rgba="0.55 0.56 0.58 1"/>
        <geom type="box" pos="-2.0 2.75 0.72" size="1.3 0.35 0.012" rgba="0.2 0.2 0.22 1"/>
        <!-- large window to trees, left wall -->
        <geom type="box" pos="-3.38 1.0 1.4" size="0.015 1.6 0.9" rgba="0.3 0.55 0.3 0.4"/>

        <body name="benchA" pos="0 -1.3 0" quat="1 0 0 1">
            <attach model="table" body="vention table" prefix="/benchA:"/>
            <body name="ucdcyto" pos="0.0 0.0 0.824">
                <attach model="ucdcyto" body="base" prefix="/ucdcyto:" />
            </body>
            <body name="1/ur5e" pos="0.5 -0. 0.824" quat="0 0 0 1">
                <attach model="ur5e" body="world" prefix="/ur:"/>
            </body>
        </body>

        <camera name="table_cam_front" pos="0 -4.4 1.9" quat="0.74967818 0.66180256 0 0" fovy="62" resolution="1280 960"/>
    </worldbody>

</mujoco>
