<mujoco model="real_lab_boston_university_room">

    <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
        <flag multiccd="enable"/>
    </option>
    <visual>
        <global azimuth="200" elevation="-14" offwidth="1280" offheight="960"/>
    </visual>

    <default>
        <default class="body"><geom contype="1" conaffinity="1"/></default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.4 0.4 0.42" rgb2="0.34 0.34 0.36" markrgb="0.46 0.46 0.48" width="300" height="300"/>
        <material name="floormat" texture="floortex" texuniform="true" texrepeat="12 12"/>
        <model name="widefield" file="../instrument/real_lab_boston_university_widefield.xml" content_type="text/xml" />
        <model name="table" file="../misc/simple_table.xml" content_type="text/xml" />

        <model name="ur5e" file="../robot/ur5e_gripper.xml" content_type="text/xml" />
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.55 0.55 0.55" ambient="0.55 0.55 0.55" pos="0 0 2.5" dir="0 0.3 -1"/>
        <light directional="true" diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" pos="0 -2 2.5" dir="0 -0.3 -1"/>
        <geom name="floor" pos="0 0 0" size="3.6 4.2 0.05" type="plane" material="floormat"/>
        <geom name="wall_back" type="box" pos="0 3.2 1.3" size="3.4 0.05 1.3" rgba="0.88 0.86 0.78 1"/>
        <geom name="wall_left" type="box" pos="-3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.88 0.86 0.78 1"/>
        <geom name="wall_right" type="box" pos="3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.88 0.86 0.78 1"/>
        <geom name="ceiling" type="box" pos="0 0.1 2.62" size="3.4 3.15 0.03" rgba="0.9 0.9 0.88 1"/>
        <geom type="box" pos="-1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="-1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>


        <!-- overhead optical-breadboard shelf with cable runs -->
        <geom type="box" pos="0 2.95 1.55" size="1.0 0.3 0.015" rgba="0.2 0.2 0.22 1"/>
        <geom type="cylinder" pos="-0.3 2.95 1.5" size="0.008 0.05" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1"/>
        <geom type="cylinder" pos="0.0 2.95 1.5" size="0.008 0.08" quat="0.707 0.707 0 0" rgba="0.1 0.1 0.1 1"/>
        <!-- black In Vivo Scientific controller box, right of the scope -->
        <geom type="box" pos="1.0 2.85 1.0" size="0.18 0.15 0.22" rgba="0.1 0.1 0.12 1"/>
        <geom type="box" pos="1.0 2.72 1.05" size="0.1 0.02 0.08" rgba="0.1 0.3 0.6 1"/>
        <!-- small reagent bottles on the bench -->
        <geom type="cylinder" pos="-1.0 2.85 0.88" size="0.025 0.06" rgba="0.5 0.35 0.15 0.8"/>
        <geom type="cylinder" pos="-0.9 2.85 0.88" size="0.025 0.06" rgba="0.8 0.8 0.75 0.6"/>

        <body name="benchA" pos="0 -1.3 0" quat="1 0 0 1">
            <attach model="table" body="vention table" prefix="/benchA:"/>
            <body name="widefield" pos="0.0 0.0 0.824">
                <attach model="widefield" body="base" prefix="/widefield:" />
            </body>
            <body name="1/ur5e" pos="0.5 -0. 0.824" quat="0 0 0 1">
                <attach model="ur5e" body="world" prefix="/ur:"/>
            </body>
        </body>

        <camera name="table_cam_front" pos="0 -4.4 1.9" quat="0.74967818 0.66180256 0 0" fovy="62" resolution="1280 960"/>
    </worldbody>

</mujoco>
