        <geom type="cylinder" pos="-2.3 3.0 2.5" size="0.02 0.8" quat="0.707 0.707 0 0" rgba="0.85 0.85 0.87 1"/>
        <geom type="cylinder" pos="-2.0 3.0 2.3" size="0.025 0.04" rgba="0.8 0.1 0.1 1"/>
        <geom type="cylinder" pos="-2.6 3.0 2.3" size="0.025 0.04" rgba="0.8 0.1 0.1 1"/>

        <body name="benchA" pos="0 -1.3 0" quat="1 0 0 1">
            <attach model="table" body="vention table" prefix="/benchA:"/>
            <body name="him2" pos="0.0 0.0 0.824">
                <attach model="him2" body="base" prefix="/him2:" />
            </body>
            <body name="1/ur5e" pos="0.5 -0. 0.824" quat="0 0 0 1">
                <attach model="ur5e" body="world" prefix="/ur:"/>
            </body>
        </body>

        <camera name="table_cam_front" pos="0 -4.4 1.9" quat="0.74967818 0.66180256 0 0" fovy="62" resolution="1280 960"/>
    </worldbody>

</mujoco>
