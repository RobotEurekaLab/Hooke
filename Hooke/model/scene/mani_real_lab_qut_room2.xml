        <geom type="cylinder" pos="-3.1 2.6 1.6" size="0.05 1.5" rgba="0.95 0.65 0.05 1"/>
        <geom type="box" pos="-3.1 2.6 3.05" size="0.15 0.4 0.08" rgba="0.85 0.55 0.05 1"/>
