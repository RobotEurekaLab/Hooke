<mujoco model="real_lab_qut_room2">

    <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
        <flag multiccd="enable"/>
    </option>
    <visual>
        <global azimuth="200" elevation="-14" offwidth="1280" offheight="960"/>
    </visual>

    <default>
        <default class="body"><geom contype="1" conaffinity="1"/></default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.88 0.86 0.78" rgb2="0.82 0.8 0.72" markrgb="0.9 0.88 0.8" width="300" height="300"/>
        <material name="floormat" texture="floortex" texuniform="true" texrepeat="12 12"/>
        <model name="him2" file="../instrument/real_lab_qut_iontof_v2.xml" content_type="text/xml" />
        <model name="desk" file="../instrument/real_lab_qut_desk.xml" content_type="text/xml" />
        <model name="table" file="../misc/simple_table.xml" content_type="text/xml" />

        <model name="ur5e" file="../robot/ur5e_gripper.xml" content_type="text/xml" />
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.55 0.55 0.55" ambient="0.55 0.55 0.55" pos="0 0 2.5" dir="0 0.3 -1"/>
        <light directional="true" diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" pos="0 -2 2.5" dir="0 -0.3 -1"/>
        <geom name="floor" pos="0 0 0" size="3.6 4.2 0.05" type="plane" material="floormat"/>
        <geom name="wall_back" type="box" pos="0 3.2 1.3" size="3.4 0.05 1.3" rgba="0.95 0.93 0.87 1"/>
        <geom name="wall_left" type="box" pos="-3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.95 0.93 0.87 1"/>
        <geom name="wall_right" type="box" pos="3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.95 0.93 0.87 1"/>
        <geom name="ceiling" type="box" pos="0 0.1 2.62" size="3.4 3.15 0.03" rgba="0.94 0.92 0.86 1"/>
        <geom type="box" pos="-1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="-1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>


        <!-- open wire shelving with supply boxes, back-left wall -->
        <geom type="box" pos="-2.6 2.95 0.55" size="0.55 0.015 0.012" rgba="0.6 0.6 0.62 1"/>
        <geom type="box" pos="-2.6 2.95 0.85" size="0.55 0.015 0.012" rgba="0.6 0.6 0.62 1"/>
        <geom type="box" pos="-2.6 2.95 1.15" size="0.55 0.015 0.012" rgba="0.6 0.6 0.62 1"/>
        <geom type="box" pos="-2.75 2.9 0.6" size="0.08 0.06 0.03" rgba="0.3 0.5 0.75 1"/>
        <geom type="box" pos="-2.55 2.9 0.6" size="0.08 0.06 0.03" rgba="0.85 0.85 0.87 1"/>
        <geom type="box" pos="-2.65 2.9 0.9" size="0.1 0.06 0.04" rgba="0.9 0.9 0.92 1"/>

        <!-- orange electrical distribution cabinet, matching the real photo -->
        <geom type="box" pos="2.3 3.0 0.9" size="0.3 0.18 0.9" rgba="0.85 0.4 0.08 1"/>
        <geom type="box" pos="2.3 2.81 1.5" size="0.3 0.01 0.25" rgba="0.75 0.35 0.05 1"/>

        <!-- window with greenery beyond, right wall -->
        <geom type="box" pos="3.38 1.0 1.6" size="0.015 0.9 0.55" rgba="0.55 0.7 0.5 0.5"/>
        <geom type="box" pos="3.38 1.0 1.6" size="0.02 0.95 0.6" rgba="0.5 0.5 0.52 1"/>

        <!-- control desk with monitors, joystick -->
        <body name="desk" pos="0.75 -1.6 0.76">
            <attach model="desk" body="base" prefix="/desk:" />
        </body>

        <!-- vibration-isolation platform + stairs (confirmed via the
             facility's own photos) -->
        <geom type="box" pos="-1.3 2.2 0.07" size="0.9 0.7 0.07" rgba="0.92 0.91 0.86 1"/>
        <geom type="box" pos="-1.3 1.55 0.035" size="0.9 0.08 0.035" rgba="0.3 0.3 0.3 1"/>
