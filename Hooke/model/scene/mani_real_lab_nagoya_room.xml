<mujoco model="real_lab_nagoya_room">

    <option integrator="implicitfast" impratio="10" cone="elliptic" noslip_iterations="2">
        <flag multiccd="enable"/>
    </option>
    <visual>
        <global azimuth="200" elevation="-14" offwidth="1280" offheight="960"/>
    </visual>

    <default>
        <default class="body"><geom contype="1" conaffinity="1"/></default>
    </default>

    <asset>
        <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
        <texture type="2d" name="floortex" builtin="checker" mark="edge" rgb1="0.18 0.18 0.2" rgb2="0.14 0.14 0.16" markrgb="0.22 0.22 0.24" width="300" height="300"/>
        <material name="floormat" texture="floortex" texuniform="true" texrepeat="12 12"/>
        <model name="palm" file="../instrument/real_lab_nagoya_university_palm.xml" content_type="text/xml" />
        <model name="table" file="../misc/simple_table.xml" content_type="text/xml" />

        <model name="ur5e" file="../robot/ur5e_gripper.xml" content_type="text/xml" />
    </asset>

    <worldbody>
        <light directional="true" diffuse="0.55 0.55 0.55" ambient="0.55 0.55 0.55" pos="0 0 2.5" dir="0 0.3 -1"/>
        <light directional="true" diffuse="0.35 0.35 0.35" ambient="0.2 0.2 0.2" pos="0 -2 2.5" dir="0 -0.3 -1"/>
        <geom name="floor" pos="0 0 0" size="3.6 4.2 0.05" type="plane" material="floormat"/>
        <geom name="wall_back" type="box" pos="0 3.2 1.3" size="3.4 0.05 1.3" rgba="0.45 0.45 0.47 1"/>
        <geom name="wall_left" type="box" pos="-3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.45 0.45 0.47 1"/>
        <geom name="wall_right" type="box" pos="3.4 0.1 1.3" size="0.05 3.1 1.3" rgba="0.45 0.45 0.47 1"/>
        <geom name="ceiling" type="box" pos="0 0.1 2.62" size="3.4 3.15 0.03" rgba="0.5 0.5 0.52 1"/>
        <geom type="box" pos="-1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 0.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="-1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="0 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>
        <geom type="box" pos="1.5 -1.5 2.595" size="0.5 0.3 0.008" rgba="1 1 1 1"/>


        <!-- grey pleated blackout curtain, back wall, per the imaging
             suite photo -->
        <geom type="box" pos="0 3.3 1.3" size="3.3 0.08 1.3" rgba="0.45 0.45 0.47 1"/>
        <geom type="cylinder" pos="-2.8 3.25 1.3" size="0.03 1.3" rgba="0.4 0.4 0.42 1"/>
        <geom type="cylinder" pos="-1.4 3.25 1.3" size="0.03 1.3" rgba="0.5 0.5 0.52 1"/>
        <geom type="cylinder" pos="0 3.25 1.3" size="0.03 1.3" rgba="0.4 0.4 0.42 1"/>
        <geom type="cylinder" pos="1.4 3.25 1.3" size="0.03 1.3" rgba="0.5 0.5 0.52 1"/>
        <geom type="cylinder" pos="2.8 3.25 1.3" size="0.03 1.3" rgba="0.4 0.4 0.42 1"/>
        <!-- second white microscope stand on the opposite bench -->
        <geom type="box" pos="1.6 2.8 0.95" size="0.18 0.18 0.3" rgba="0.92 0.92 0.9 1"/>
        <geom type="cylinder" pos="1.6 2.8 1.3" size="0.05 0.12" rgba="0.1 0.1 0.1 1"/>
        <!-- central monitor on a stand -->
        <geom type="box" pos="-0.3 2.9 1.2" size="0.18 0.03 0.13" rgba="0.1 0.1 0.12 1"/>

        <body name="benchA" pos="0 -1.3 0" quat="1 0 0 1">
            <attach model="table" body="vention table" prefix="/benchA:"/>
            <body name="palm" pos="0.0 0.0 0.824">
                <attach model="palm" body="base" prefix="/palm:" />
            </body>
            <body name="1/ur5e" pos="0.5 -0. 0.824" quat="0 0 0 1">
                <attach model="ur5e" body="world" prefix="/ur:"/>
            </body>
        </body>

        <camera name="table_cam_front" pos="0 -4.4 1.9" quat="0.74967818 0.66180256 0 0" fovy="62" resolution="1280 960"/>
    </worldbody>

</mujoco>
