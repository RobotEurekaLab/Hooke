}
/* Force images in THIS SPECIFIC grid to be the same size */
.uniform-image-grid .listing-item .image img {
    width: 100%; 
    height: 250px; 
    object-fit: cover; 
    border-radius: 8px; 
}

/* Ensure the container columns align nicely for THIS grid */
.uniform-image-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}		</style>
